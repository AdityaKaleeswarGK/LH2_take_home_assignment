# Machine-local Claude Code permissions
.claude/settings.local.json

# Working clones of analysed repositories. The evidence that matters is copied
# into evidence/ and the deliverable into output/; the clone itself carries its
# own .git and 67MB of provisioned virtualenvs under .stress_stack/tools/.
/glom/
/pluggy/

# The deliverable is regenerated by every run. The evidence that matters is
# committed under evidence/; output/ is a build product. The suffixed variants
# are the same thing from a `--output` override during verification runs.
/output/
/output-*/

# The project's own lockfile, left untracked as it was before this work. Track it
# deliberately if you want it pinned; it should not arrive via `git add -A`.
uv.lock
